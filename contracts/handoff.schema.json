{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luz.local/schemas/design-handoff.schema.json",
  "title": "Luz design-to-development handoff",
  "description": "Stable, implementation-ready contract produced by Luz Design and consumed by Luz Dev.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "surfaces",
    "roles",
    "designSystem",
    "flows",
    "screens",
    "components",
    "assets",
    "apiIntents",
    "acceptance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "summary",
        "audience",
        "outcome",
        "goals",
        "nonGoals",
        "assumptions",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "nonGoals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "mini-program",
          "admin",
          "mobile-app"
        ]
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "designSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positioning",
        "tokenSources",
        "componentLibrary",
        "accessibility"
      ],
      "properties": {
        "positioning": {
          "type": "string",
          "minLength": 1
        },
        "tokenSources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "componentLibrary": {
          "type": "string",
          "minLength": 1
        },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contrastEvidence",
            "keyboardOrTouchEvidence",
            "reducedMotion",
            "contentScaling"
          ],
          "properties": {
            "contrastEvidence": {
              "type": "string",
              "minLength": 1
            },
            "keyboardOrTouchEvidence": {
              "type": "string",
              "minLength": 1
            },
            "reducedMotion": {
              "type": "string",
              "minLength": 1
            },
            "contentScaling": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "roleId",
          "entryScreenId",
          "outcome",
          "steps",
          "recovery"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "roleId": {
            "type": "string",
            "minLength": 1
          },
          "entryScreenId": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recovery": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "surface",
          "title",
          "route",
          "roleIds",
          "flowIds",
          "purpose",
          "states",
          "componentIds",
          "assetIds",
          "apiIntentIds",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "surface": {
            "enum": [
              "mini-program",
              "admin",
              "mobile-app"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": "string",
            "minLength": 1
          },
          "roleIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "flowIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "states": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "loading",
                "empty",
                "partial",
                "error",
                "offline",
                "timeout",
                "permission",
                "expired",
                "unavailable",
                "success"
              ]
            }
          },
          "componentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "assetIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "apiIntentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "responsive": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "surface",
          "variants",
          "states",
          "contentLimits",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "surface": {
            "enum": [
              "shared",
              "mini-program",
              "admin",
              "mobile-app"
            ]
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "contentLimits": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "path",
          "purpose",
          "source",
          "license",
          "textInImage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "image",
              "icon",
              "illustration",
              "video",
              "font",
              "logo",
              "texture",
              "other"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "textInImage": {
            "const": false
          },
          "altText": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "apiIntents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "screenId",
          "need",
          "data",
          "actions",
          "errorsDisplayed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "screenId": {
            "type": "string",
            "minLength": 1
          },
          "need": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "errorsDisplayed": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "poster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brief",
        "format",
        "placement",
        "copySource",
        "sourceFile",
        "preview",
        "exports",
        "safeArea",
        "accessibility"
      ],
      "properties": {
        "brief": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "placement": {
          "type": "string",
          "minLength": 1
        },
        "copySource": {
          "type": "string",
          "minLength": 1
        },
        "sourceFile": {
          "type": "string",
          "minLength": 1
        },
        "preview": {
          "type": "string",
          "minLength": 1
        },
        "exports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "safeArea": {
          "type": "string",
          "minLength": 1
        },
        "accessibility": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "criterion",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "openDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "owner",
          "blocksImplementation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "blocksImplementation": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
