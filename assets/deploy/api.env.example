# 复制到服务器 /etc/luz/api.env（权限 600，属主为部署用户）。这里只写变量名与说明，不写真实值。
# 每个变量在项目 config/<env>.md 中记录：用途、获取方式、验证方法（PROC-004）。

APP_ENV=production
DATABASE_URL=postgresql+psycopg://<user>:<password>@postgres:5432/<db>
REDIS_URL=redis://:<password>@redis:6379/0
JWT_SECRET=<随机 32 字节以上>

# 微信小程序
WECHAT_APPID=<小程序 appid>
WECHAT_APP_SECRET=<仅服务端，见 AUTH-003>

# 微信支付（backend/09-wechat-pay/MODULE.md §10）
WECHAT_PAY_APPID=<与商户号绑定的 appid>
WECHAT_PAY_MCHID=<商户号>
WECHAT_PAY_APIV3_KEY=<32 字节>
WECHAT_PAY_PRIVATE_KEY_PATH=/etc/luz/keys/apiclient_key.pem
WECHAT_PAY_CERT_SERIAL=<商户 API 证书序列号>
WECHAT_PAY_PUBLIC_KEYS=<PUB_KEY_ID_xxx>=/etc/luz/keys/wechatpay_pub.pem
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/v1/payments/notify/wechat
WECHAT_PAY_REFUND_NOTIFY_URL=https://api.example.com/api/v1/payments/notify/wechat/refund

# 对象存储、短信、地图等第三方服务按项目补充
# 生产环境不得出现 LUZ_PAY_NOTIFY_SECRET（仅本地联调，PAY-015）
