FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /srv/agent
RUN addgroup --system luz && adduser --system --ingroup luz --home /srv luz
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
ENV PYTHONPATH=/srv/agent/00-core/code:/srv/agent/01-gateway/code:/srv/agent/02-graph/code:/srv/agent/03-intent/code:/srv/agent/04-memory/code:/srv/agent/05-knowledge/code:/srv/agent/06-tools/code:/srv/agent/07-confirm/code:/srv/agent/08-resilience/code:/srv/agent/09-verify/code:/srv/agent/10-llm/code:/srv/agent/11-observability/code
USER luz
EXPOSE 8100
CMD ["uvicorn", "agent_gateway.app:app", "--host", "0.0.0.0", "--port", "8100"]
