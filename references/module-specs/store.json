{
  "id": "store",
  "order": 20,
  "name": "门店与配置",
  "modules": [
    "store",
    "settings"
  ],
  "summary": "维护门店资料、营业时段、容量与状态，以及全局和门店级配置项；为入场、预约、报表提供门店范围。",
  "features": [
    {
      "name": "门店资料",
      "description": "名称、编码、地址与坐标、联系电话、营业时段、容量、时区。"
    },
    {
      "name": "门店状态",
      "description": "筹备、营业中、暂停营业（临时，可带恢复时间）、休息中（营业时段外自动）、已关闭；状态只存一份，下单、支付、入场、设备与外卖平台都读它。暂停与休息时不可下单、购卡与入场，关闭前需处理有效会员卡。"
    },
    {
      "name": "实时人数",
      "description": "在场人数随入场、离场条件更新，小程序只显示空闲、适中、拥挤三档。"
    },
    {
      "name": "配置项",
      "description": "全局默认值与门店覆盖值，如待支付时长、在场超时时长、预约取消时限；修改即时生效并审计。"
    },
    {
      "name": "附近门店",
      "description": "按定位距离排序，显示营业状态与人数档位。"
    },
    {
      "name": "一键开业与停业",
      "description": "后台顶栏与门店列表一键切换，可批量；停业前预览影响（进行中订单、待支付订单、将切换的设备），选择在途订单处理与储值、买卡、续费、积分兑换是否同时暂停；开业前做开业检查，阻断项不通过不能开业；每次切换写营业日志。"
    },
    {
      "name": "停业联动",
      "description": "创建订单、发起支付、支付回调三处都校验营业状态；设备按登记的停业动作统一下发并逐台回报；外卖平台门店同步置休；营业时段到点自动进入休息中并恢复。"
    }
  ],
  "flows": [
    {
      "name": "小程序选择门店",
      "steps": [
        "前端获取定位（用户拒绝时按城市列表展示）调用 `GET /api/v1/app/stores`。",
        "服务端按距离排序，返回营业状态（按门店时区与营业时段计算）与人数档位。",
        "用户选择门店后保存在本地，后续卡种、预约、入场接口携带 store_id。"
      ]
    },
    {
      "name": "读取配置",
      "steps": [
        "业务代码按 key 读取配置：先取门店覆盖值，没有则取全局默认值，再没有使用代码内默认值。",
        "配置缓存在 Redis，后台修改写库后删除对应缓存。"
      ]
    },
    {
      "name": "一键停业",
      "steps": [
        "后台调用 `GET /api/v1/admin/stores/{id}/close-preview`，服务端统计进行中订单、待支付订单与该店设备，返回影响与默认选项。",
        "店长在确认框选择原因、恢复方式、在途订单处理与暂停范围后调用 `POST /api/v1/admin/stores/{id}/close`（带 `Idempotency-Key` 与读到的 `status_version`）。",
        "服务端在一个事务里用条件更新把状态改为 paused、写 `store_status_logs` 与停业公告，并在 Outbox 写入设备指令与外卖平台置休任务；事务提交即停业生效。",
        "待支付订单按策略处理：默认关闭并释放库存与券；进行中订单默认继续制作，选择退款时逐单原路退款。",
        "Outbox 投递设备指令 `store/{id}/business-state`，逐台记录回执；失败重试 3 次后告警，不回滚停业。"
      ]
    },
    {
      "name": "一键开业",
      "steps": [
        "后台调用 `GET /api/v1/admin/stores/{id}/open-check`：支付通道、收银与打印、关键设备在线、售罄与库存、营业时段逐项检查并返回 `check_id`。",
        "阻断项全部通过后调用 `POST /api/v1/admin/stores/{id}/open`（带 `check_id`），条件更新为 open、写营业日志、下发恢复指令。",
        "检查结果超过 5 分钟或期间状态变化时要求重新检查。"
      ]
    },
    {
      "name": "停业后的下单与支付",
      "steps": [
        "`POST /api/v1/app/orders` 与 `POST /api/v1/app/payments` 先读门店营业状态，非营业中返回 STORE_NOT_OPEN（附恢复时间与可预约时段），不创建订单、不发起预支付。",
        "支付回调到达时再查一次：停业前已发起、停业后到账的支付按停业时选择的在途订单处理执行，继续制作或自动原路退款并通知用户。",
        "允许预约时，只接受落在营业时段内的预约单。"
      ]
    },
    {
      "name": "营业时段自动开关",
      "steps": [
        "定时任务每分钟按门店时区与营业时段（含节假日例外）计算应处状态，open 与 resting 互相切换。",
        "人工停业（paused）的门店不被定时任务恢复；到达 `resume_at` 时先做开业检查，通过才恢复，不通过则保持停业并告警。"
      ]
    }
  ],
  "inputs": [
    {
      "page": "门店编辑页（后台）",
      "field": "name",
      "label": "门店名称",
      "type": "文本",
      "required": true,
      "rule": "2–30 个字符。"
    },
    {
      "page": "门店编辑页（后台）",
      "field": "code",
      "label": "门店编码",
      "type": "文本",
      "required": true,
      "rule": "字母数字，创建后不可改，用于门店码。"
    },
    {
      "page": "门店编辑页（后台）",
      "field": "address",
      "label": "详细地址",
      "type": "文本",
      "required": true,
      "rule": "与地图选点一致。"
    },
    {
      "page": "门店编辑页（后台）",
      "field": "location",
      "label": "位置",
      "type": "地图选点",
      "required": true,
      "rule": "保存经纬度。"
    },
    {
      "page": "门店编辑页（后台）",
      "field": "capacity",
      "label": "最大在场人数",
      "type": "数字",
      "required": true,
      "rule": "1–500，按消防与场地面积确定。"
    },
    {
      "page": "门店编辑页（后台）",
      "field": "open_rule",
      "label": "营业时段",
      "type": "时段选择",
      "required": true,
      "rule": "支持全天 24 小时或分时段，按星期设置。"
    },
    {
      "page": "门店编辑页（后台）",
      "field": "contact_phone",
      "label": "联系电话",
      "type": "文本",
      "required": true,
      "rule": "对会员公开的客服电话。"
    },
    {
      "page": "配置页（后台）",
      "field": "value",
      "label": "配置值",
      "type": "按配置类型",
      "required": true,
      "rule": "数值类有上下限，例如待支付时长 5–30 分钟。"
    }
  ],
  "apis": [
    {
      "method": "GET",
      "path": "/api/v1/app/stores",
      "caller": "小程序",
      "purpose": "附近门店",
      "request": "latitude，longitude（可选），city_code（可选）",
      "response": "门店列表：id，name，address，distance_m，is_open，occupancy_level",
      "errors": "—"
    },
    {
      "method": "GET",
      "path": "/api/v1/app/stores/{id}",
      "caller": "小程序",
      "purpose": "门店详情",
      "request": "无",
      "response": "门店资料、营业时段、人数档位、可售卡种数量",
      "errors": "NOT_FOUND"
    },
    {
      "method": "POST",
      "path": "/api/v1/admin/stores",
      "caller": "后台",
      "purpose": "创建门店",
      "request": "门店资料",
      "response": "store_id",
      "errors": "CODE_EXISTS，VALIDATION_FAILED"
    },
    {
      "method": "PATCH",
      "path": "/api/v1/admin/stores/{id}",
      "caller": "后台",
      "purpose": "修改门店",
      "request": "需修改的字段",
      "response": "门店资料",
      "errors": "STORE_HAS_ACTIVE_CARDS（关闭时）"
    },
    {
      "method": "GET",
      "path": "/api/v1/admin/settings",
      "caller": "后台",
      "purpose": "配置列表",
      "request": "store_id（可选）",
      "response": "key，value，默认值，覆盖来源",
      "errors": "—"
    },
    {
      "method": "PUT",
      "path": "/api/v1/admin/settings/{key}",
      "caller": "后台",
      "purpose": "修改配置",
      "request": "store_id（可选），value",
      "response": "生效后的值",
      "errors": "VALIDATION_FAILED"
    },
    {
      "method": "GET",
      "path": "/api/v1/admin/stores/{id}/close-preview",
      "caller": "后台",
      "purpose": "停业影响预览",
      "request": "无",
      "response": "inflight_orders，pending_payments，devices[{device_id，name，close_action}]，status_version，默认选项",
      "errors": "FORBIDDEN"
    },
    {
      "method": "POST",
      "path": "/api/v1/admin/stores/{id}/close",
      "caller": "后台",
      "purpose": "一键停业",
      "request": "reason，resume_at（可选），inflight_policy（finish 或 refund），allow_reservation，pause_scopes（wallet，card，renewal，points），notice_text，status_version",
      "response": "status，log_id，device_tasks",
      "errors": "STATUS_CHANGED，STORE_NOT_OPEN，FORBIDDEN"
    },
    {
      "method": "GET",
      "path": "/api/v1/admin/stores/{id}/open-check",
      "caller": "后台",
      "purpose": "开业检查",
      "request": "无",
      "response": "check_id，checks[{item，ok，blocking，reason，fix_route}]",
      "errors": "FORBIDDEN"
    },
    {
      "method": "POST",
      "path": "/api/v1/admin/stores/{id}/open",
      "caller": "后台",
      "purpose": "一键开业",
      "request": "check_id，status_version",
      "response": "status，log_id，device_tasks",
      "errors": "OPEN_CHECK_FAILED，OPEN_CHECK_EXPIRED，STATUS_CHANGED"
    },
    {
      "method": "GET",
      "path": "/api/v1/admin/stores/{id}/status-logs",
      "caller": "后台",
      "purpose": "营业日志",
      "request": "分页参数",
      "response": "时间、操作人或定时任务、原因、前后状态、受影响订单数、设备结果",
      "errors": "—"
    },
    {
      "method": "MQTT",
      "path": "store/{id}/business-state",
      "caller": "设备",
      "purpose": "下发营业状态",
      "request": "command_id，state，issued_at，签名",
      "response": "回执：command_id，result，error",
      "errors": "超时视为失败并重试"
    },
    {
      "method": "TASK",
      "path": "store-business-hours",
      "caller": "定时任务",
      "purpose": "营业时段自动开关与定时恢复",
      "request": "每分钟",
      "response": "切换的门店与结果",
      "errors": "—"
    }
  ],
  "results": [
    {
      "case": "打开门店列表",
      "page": "门店列表页",
      "display": "每个门店显示距离、营业中或已打烊、人数档位，点击进入门店详情。"
    },
    {
      "case": "门店详情",
      "page": "门店详情页",
      "display": "地址与导航按钮、营业时段、当前人数档位、「购买会员卡」与「预约课程」入口。"
    },
    {
      "case": "门店暂停营业",
      "page": "门店详情页",
      "display": "顶部显示暂停原因与预计恢复时间，购卡与入场按钮不可用。"
    },
    {
      "case": "停业后打开小程序",
      "page": "门店栏与菜单页",
      "display": "门店栏显示暂停营业与恢复时间，菜单顶部停业公告，首次进入弹一次强公告；菜单可浏览，加购与结算按钮为不可点的“暂停营业”。"
    },
    {
      "case": "后台停业完成",
      "page": "后台顶栏与营业日志",
      "display": "状态胶囊变为暂停营业；设备逐台显示已切换、重试中或失败，失败项可重试。"
    }
  ],
  "writes": [
    {
      "when": "创建或修改门店",
      "table": "stores",
      "content": "门店资料与状态。"
    },
    {
      "when": "修改配置",
      "table": "store_settings",
      "content": "store_id、key、value、updated_by。"
    },
    {
      "when": "修改门店或配置",
      "table": "audit_logs",
      "content": "修改前后的值。"
    },
    {
      "when": "停业或开业",
      "table": "stores、store_status_logs、outbox_events、audit_logs",
      "content": "新状态与 status_version；切换原因、选项与影响；设备与外卖平台任务；操作人。"
    },
    {
      "when": "设备回执",
      "table": "store_device_commands",
      "content": "command_id 对应的结果、次数与错误。"
    }
  ],
  "tables": [
    {
      "name": "stores",
      "label": "门店",
      "purpose": "门店资料、容量与实时人数",
      "fields": [
        {
          "name": "code",
          "type": "VARCHAR(16)",
          "required": true,
          "default": "—",
          "comment": "门店编码，唯一"
        },
        {
          "name": "name",
          "type": "VARCHAR(40)",
          "required": true,
          "default": "—",
          "comment": "门店名称"
        },
        {
          "name": "city_code",
          "type": "CHAR(6)",
          "required": true,
          "default": "—",
          "comment": "行政区划代码"
        },
        {
          "name": "address",
          "type": "VARCHAR(200)",
          "required": true,
          "default": "—",
          "comment": "详细地址"
        },
        {
          "name": "latitude",
          "type": "NUMERIC(9,6)",
          "required": true,
          "default": "—",
          "comment": "纬度"
        },
        {
          "name": "longitude",
          "type": "NUMERIC(9,6)",
          "required": true,
          "default": "—",
          "comment": "经度"
        },
        {
          "name": "contact_phone",
          "type": "VARCHAR(20)",
          "required": true,
          "default": "—",
          "comment": "客服电话"
        },
        {
          "name": "capacity",
          "type": "INTEGER",
          "required": true,
          "default": "—",
          "comment": "最大在场人数"
        },
        {
          "name": "current_occupancy",
          "type": "INTEGER",
          "required": true,
          "default": "0",
          "comment": "当前在场人数，只做条件加减"
        },
        {
          "name": "open_rule",
          "type": "JSONB",
          "required": true,
          "default": "—",
          "comment": "营业时段，按星期的时间段列表"
        },
        {
          "name": "timezone",
          "type": "VARCHAR(32)",
          "required": true,
          "default": "Asia/Shanghai",
          "comment": "门店时区"
        },
        {
          "name": "status",
          "type": "VARCHAR(16)",
          "required": true,
          "default": "preparing",
          "comment": "preparing、open、paused、closed"
        },
        {
          "name": "pause_reason",
          "type": "VARCHAR(200)",
          "required": false,
          "default": "—",
          "comment": "暂停原因"
        },
        {
          "name": "resume_at",
          "type": "TIMESTAMPTZ",
          "required": false,
          "default": "—",
          "comment": "定时恢复营业的时间"
        },
        {
          "name": "status_version",
          "type": "INTEGER",
          "required": true,
          "default": "0",
          "comment": "状态版本，切换用条件更新防并发"
        },
        {
          "name": "pause_scopes",
          "type": "JSONB",
          "required": false,
          "default": "—",
          "comment": "停业时同时暂停的业务：储值、买卡、续费、积分兑换"
        }
      ],
      "indexes": [
        "UNIQUE(code)",
        "INDEX(city_code, status)",
        "CHECK(current_occupancy >= 0)"
      ]
    },
    {
      "name": "store_settings",
      "label": "配置",
      "purpose": "全局默认与门店覆盖配置",
      "fields": [
        {
          "name": "store_id",
          "type": "BIGINT",
          "required": false,
          "default": "—",
          "comment": "门店；为空表示全局默认"
        },
        {
          "name": "key",
          "type": "VARCHAR(64)",
          "required": true,
          "default": "—",
          "comment": "配置键，如 order.pay_timeout_minutes"
        },
        {
          "name": "value",
          "type": "JSONB",
          "required": true,
          "default": "—",
          "comment": "配置值"
        },
        {
          "name": "updated_by",
          "type": "BIGINT",
          "required": true,
          "default": "—",
          "comment": "修改人"
        }
      ],
      "indexes": [
        "UNIQUE(store_id, key) NULLS NOT DISTINCT"
      ]
    },
    {
      "name": "store_status_logs",
      "label": "营业日志",
      "purpose": "每次营业状态切换的原因、选项与影响",
      "fields": [
        {
          "name": "store_id",
          "type": "BIGINT",
          "required": true,
          "default": "—",
          "comment": "门店"
        },
        {
          "name": "from_status",
          "type": "VARCHAR(16)",
          "required": true,
          "default": "—",
          "comment": "切换前状态"
        },
        {
          "name": "to_status",
          "type": "VARCHAR(16)",
          "required": true,
          "default": "—",
          "comment": "切换后状态"
        },
        {
          "name": "source",
          "type": "VARCHAR(16)",
          "required": true,
          "default": "—",
          "comment": "manual、schedule 或 platform"
        },
        {
          "name": "operator_id",
          "type": "BIGINT",
          "required": false,
          "default": "—",
          "comment": "操作人；定时任务为空"
        },
        {
          "name": "reason",
          "type": "VARCHAR(200)",
          "required": false,
          "default": "—",
          "comment": "停业原因"
        },
        {
          "name": "options",
          "type": "JSONB",
          "required": true,
          "default": "{}",
          "comment": "恢复时间、在途订单处理、暂停范围、公告文案"
        },
        {
          "name": "impact",
          "type": "JSONB",
          "required": true,
          "default": "{}",
          "comment": "受影响的订单数与设备结果汇总"
        }
      ],
      "indexes": [
        "INDEX(store_id, created_at)"
      ]
    },
    {
      "name": "store_device_commands",
      "label": "设备指令",
      "purpose": "营业状态下发到每台设备的指令与回执",
      "fields": [
        {
          "name": "store_id",
          "type": "BIGINT",
          "required": true,
          "default": "—",
          "comment": "门店"
        },
        {
          "name": "device_id",
          "type": "BIGINT",
          "required": true,
          "default": "—",
          "comment": "设备"
        },
        {
          "name": "command_id",
          "type": "UUID",
          "required": true,
          "default": "—",
          "comment": "指令编号，设备按它去重"
        },
        {
          "name": "target_state",
          "type": "VARCHAR(16)",
