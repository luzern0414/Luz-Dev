{
  "id": "admin",
  "order": 90,
  "name": "后台账号与权限",
  "modules": [
    "admin-rbac"
  ],
  "summary": "门店后台与值班台的账号、角色、权限码与门店数据范围；登录防爆破，敏感操作二次确认并审计。",
  "features": [
    {
      "name": "后台登录",
      "description": "账号密码 + 图形验证码；连续失败 5 次锁定 15 分钟；可开启短信二次验证。"
    },
    {
      "name": "角色与权限码",
      "description": "角色绑定权限码（如 order.refund.approve），接口按权限码校验。"
    },
    {
      "name": "门店数据范围",
      "description": "账号绑定可管理的门店，查询自动附加门店范围。"
    },
    {
      "name": "敏感操作",
      "description": "退款审核、远程开门、导出、调整余额与次数需要二次确认并写审计。"
    },
    {
      "name": "审计查询",
      "description": "按操作者、对象、动作、时间查询审计记录。"
    }
  ],
  "flows": [
    {
      "name": "后台登录",
      "steps": [
        "提交账号、密码、验证码到 `POST /api/v1/admin/auth/login`。",
        "校验验证码后比对密码摘要（bcrypt）；失败计数加一，达到 5 次锁定 15 分钟。",
        "开启二次验证的账号发送短信验证码，验证成功后签发后台令牌（8 小时，空闲 30 分钟失效）。",
        "返回账号信息、权限码列表与可管理门店。"
      ]
    },
    {
      "name": "接口鉴权",
      "steps": [
        "中间件解析后台令牌，读取账号的权限码与门店范围（缓存，变更即删除）。",
        "缺少权限码返回 FORBIDDEN；访问范围外门店的数据返回 NOT_FOUND，不暴露存在性。"
      ]
    }
  ],
  "inputs": [
    {
      "page": "后台登录页",
      "field": "username",
      "label": "账号",
      "type": "文本",
      "required": true,
      "rule": "4–32 位。"
    },
    {
      "page": "后台登录页",
      "field": "password",
      "label": "密码",
      "type": "密码框",
      "required": true,
      "rule": "至少 10 位，含字母与数字；首次登录强制修改。"
    },
    {
      "page": "后台登录页",
      "field": "captcha",
      "label": "图形验证码",
      "type": "文本",
      "required": true,
      "rule": "5 分钟内有效，一次性。"
    },
    {
      "page": "账号编辑页",
      "field": "role_ids",
      "label": "角色",
      "type": "多选",
      "required": true,
      "rule": "至少一个角色。"
    },
    {
      "page": "账号编辑页",
      "field": "store_ids",
      "label": "可管理门店",
      "type": "多选",
      "required": true,
      "rule": "总部角色可选全部门店。"
    }
  ],
  "apis": [
    {
      "method": "POST",
      "path": "/api/v1/admin/auth/login",
      "caller": "后台",
      "purpose": "后台登录",
      "request": "username，password，captcha_id，captcha",
      "response": "token，need_mfa，admin{name，permissions[]，stores[]}",
      "errors": "CREDENTIALS_INVALID，ACCOUNT_LOCKED，CAPTCHA_INVALID"
    },
    {
      "method": "POST",
      "path": "/api/v1/admin/auth/mfa",
      "caller": "后台",
      "purpose": "二次验证",
      "request": "mfa_ticket，sms_code",
      "response": "token",
      "errors": "MFA_INVALID"
    },
    {
      "method": "GET",
      "path": "/api/v1/admin/admin-users",
      "caller": "后台",
      "purpose": "账号列表",
      "request": "keyword，cursor",
      "response": "账号列表",
      "errors": "FORBIDDEN"
    },
    {
      "method": "POST",
      "path": "/api/v1/admin/admin-users",
      "caller": "后台",
      "purpose": "创建账号",
      "request": "username，name，phone，role_ids，store_ids",
      "response": "admin_user_id，初始密码（仅返回一次）",
      "errors": "USERNAME_EXISTS"
    },
    {
      "method": "PUT",
      "path": "/api/v1/admin/roles/{id}/permissions",
      "caller": "后台",
      "purpose": "设置角色权限",
      "request": "permission_codes[]",
      "response": "角色权限",
      "errors": "FORBIDDEN"
    },
    {
      "method": "GET",
      "path": "/api/v1/admin/audit-logs",
      "caller": "后台",
      "purpose": "审计查询",
      "request": "actor_id，action，object_type，from，to，cursor",
      "response": "审计记录",
      "errors": "FORBIDDEN"
    }
  ],
  "results": [
    {
      "case": "登录成功",
      "page": "后台首页",
      "display": "按权限显示菜单，默认选中第一家可管理门店。"
    },
    {
      "case": "账号被锁定",
      "page": "登录页",
      "display": "显示剩余锁定时间。"
    },
    {
      "case": "权限不足",
      "page": "无权限页",
      "display": "说明缺少的操作权限，联系管理员。"
    }
  ],
  "writes": [
    {
      "when": "登录成功或失败",
      "table": "admin_users",
      "content": "failed_count、locked_until、last_login_at。"
    },
    {
      "when": "登录与敏感操作",
      "table": "audit_logs",
      "content": "账号、IP、动作、对象、结果。"
    },
    {
      "when": "账号或角色变更",
      "table": "admin_user_roles、admin_user_stores、role_permissions",
      "content": "新的绑定关系。"
    }
  ],
  "tables": [
    {
      "name": "admin_users",
      "label": "后台账号",
      "purpose": "后台与值班台账号",
      "fields": [
        {
          "name": "username",
          "type": "VARCHAR(32)",
          "required": true,
          "default": "—",
          "comment": "账号，唯一"
        },
        {
          "name": "name",
          "type": "VARCHAR(40)",
          "required": true,
          "default": "—",
          "comment": "姓名"
        },
        {
          "name": "phone_cipher",
          "type": "TEXT",
          "required": false,
          "default": "—",
          "comment": "手机号密文，用于二次验证"
        },
        {
          "name": "password_hash",
          "type": "VARCHAR(100)",
          "required": true,
          "default": "—",
          "comment": "密码摘要（bcrypt）"
        },
        {
          "name": "mfa_enabled",
          "type": "BOOLEAN",
          "required": true,
          "default": "false",
          "comment": "是否开启短信二次验证"
        },
        {
          "name": "status",
          "type": "VARCHAR(16)",
          "required": true,
          "default": "active",
          "comment": "active、disabled"
        },
        {
          "name": "failed_count",
          "type": "SMALLINT",
          "required": true,
          "default": "0",
          "comment": "连续登录失败次数"
        },
        {
          "name": "locked_until",
          "type": "TIMESTAMPTZ",
          "required": false,
          "default": "—",
          "comment": "锁定截止时间"
        },
        {
          "name": "must_change_password",
          "type": "BOOLEAN",
          "required": true,
          "default": "true",
          "comment": "首次登录须修改密码"
        },
        {
          "name": "last_login_at",
          "type": "TIMESTAMPTZ",
          "required": false,
          "default": "—",
          "comment": "最近登录时间"
        }
      ],
      "indexes": [
        "UNIQUE(username)"
      ]
    },
    {
      "name": "roles",
      "label": "角色",
      "purpose": "权限分组",
      "fields": [
        {
          "name": "code",
          "type": "VARCHAR(32)",
          "required": true,
          "default": "—",
          "comment": "角色编码，如 store_manager"
        },
        {
          "name": "name",
          "type": "VARCHAR(40)",
          "required": true,
          "default": "—",
          "comment": "角色名称"
        },
        {
          "name": "is_system",
          "type": "BOOLEAN",
          "required": true,
          "default": "false",
          "comment": "系统内置角色不可删除"
        }
      ],
      "indexes": [
        "UNIQUE(code)"
      ]
    },
    {
      "name": "role_permissions",
      "label": "角色权限",
      "purpose": "角色拥有的权限码",
      "fields": [
        {
          "name": "role_id",
          "type": "BIGINT",
          "required": true,
          "default": "—",
          "comment": "角色"
        },
        {
          "name": "permission_code",
          "type": "VARCHAR(64)",
          "required": true,
          "default": "—",
          "comment": "权限码，如 order.refund.approve"
        }
      ],
      "indexes": [
        "UNIQUE(role_id, permission_code)"
      ]
    },
    {
      "name": "admin_user_roles",
      "label": "账号角色",
      "purpose": "账号与角色关系",
      "fields": [
        {
          "name": "admin_user_id",
          "type": "BIGINT",
          "required": true,
          "default": "—",
          "comment": "后台账号"
        },
        {
          "name": "role_id",
          "type": "BIGINT",
          "required": true,
          "default": "—",
          "comment": "角色"
        }
      ],
      "indexes": [
        "UNIQUE(admin_user_id, role_id)"
      ]
    },
    {
      "name": "admin_user_stores",
      "label": "账号门店范围",
      "purpose": "账号可管理的门店",
      "fields": [
        {
          "name": "admin_user_id",
          "type": "BIGINT",
          "required": true,
          "default": "—",
          "comment": "后台账号"
        },
        {
          "name": "store_id",
          "type": "BIGINT",
          "required": true,
          "default": "—",
          "comment": "门店"
        }
      ],
      "indexes": [
        "UNIQUE(admin_user_id, store_id)"
      ]
    }
  ],
  "states": [
    {
      "entity": "后台账号",
      "from": "active",
      "event": "连续失败 5 次",
      "to": "active（锁定中）",
      "condition": "locked_until 到期自动解锁"
    },
    {
      "entity": "后台账号",
      "from": "active",
      "event": "停用",
      "to": "disabled",
      "condition": "吊销全部令牌"
    }
  ],
  "exceptions": [
    {
      "case": "越权访问其他门店数据",
      "handling": "数据访问层统一附加门店范围，返回 NOT_FOUND 并记录安全事件。"
    },
    {
      "case": "权限变更后的旧令牌",
      "handling": "权限缓存删除后下一次请求即按新权限校验。"
    },
    {
      "case": "最后一个超级管理员被停用或删除",
      "handling": "拒绝操作，保证至少保留一个。"
    }
  ]
}
