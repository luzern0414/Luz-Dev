{
  "id": "login",
  "order": 10,
  "name": "登录与账号",
  "modules": [
    "login",
    "auth"
  ],
  "summary": "小程序会员通过微信身份登录，按需绑定手机号；服务端签发短期访问令牌与可轮换的刷新令牌；支持资料修改、后台禁用与账号注销。",
  "features": [
    {
      "name": "微信一键登录",
      "description": "以 wx.login 的 code 换取 openid，首次登录自动建档；session_key 只留在服务端。"
    },
    {
      "name": "手机号绑定",
      "description": "通过手机号快捷验证组件取得手机号，加密保存，展示时脱敏；下单、储值、入场前要求已绑定。"
    },
    {
      "name": "令牌与会话",
      "description": "访问令牌 2 小时，刷新令牌 30 天并在每次使用时轮换；同一登录链的旧刷新令牌被再次使用时整链吊销。"
    },
    {
      "name": "个人资料",
      "description": "昵称、头像、性别、生日；昵称与头像经内容安全检测后生效。"
    },
    {
      "name": "账号注销",
      "description": "提交申请后进入 15 天冷静期，可撤回；期满匿名化个人信息，交易记录按法定年限保留。"
    },
    {
      "name": "后台禁用",
      "description": "后台可禁用会员，禁用即时生效，所有会话失效。"
    }
  ],
  "flows": [
    {
      "name": "小程序登录",
      "steps": [
        "小程序调用 wx.login 取得 code，连同已勾选的协议版本调用 `POST /api/v1/app/auth/wechat`。",
        "服务端用 code 调用 code2Session 取得 openid、unionid 与 session_key；session_key 写入缓存（有效 1 天），不下发到前端。",
        "按 openid 查找会员：不存在则创建（status=active，home_store_id 取进入小程序时携带的门店码），并写入协议同意记录。",
        "会员为 disabled 时返回 ACCOUNT_DISABLED，不签发令牌。",
        "签发访问令牌（含 member_id、过期时间）与刷新令牌；刷新令牌只保存摘要到 member_sessions。",
        "返回令牌、会员概要、是否已绑定手机号，以及需要重新同意的协议列表。"
      ]
    },
    {
      "name": "绑定手机号",
      "steps": [
        "用户点击手机号快捷验证按钮，前端取得 phone_code 后调用 `POST /api/v1/app/me/phone`。",
        "服务端调用 getuserphonenumber 换取手机号；号码已绑定到其他会员时返回 PHONE_IN_USE，由客服核实后合并。",
        "写入 phone_cipher（加密）、phone_hash（检索用的带密钥摘要）、phone_masked（138****0000），记录审计。"
      ]
    },
    {
      "name": "刷新令牌",
      "steps": [
        "访问令牌过期后前端调用 `POST /api/v1/app/auth/refresh`。",
        "刷新令牌有效且未使用：签发新的一对令牌，旧会话记录 replaced_by。",
        "刷新令牌已被使用过：判定为泄露，吊销同一 family_id 下全部会话，返回 REFRESH_REUSED，前端回到登录页。"
      ]
    },
    {
      "name": "账号注销",
      "steps": [
        "会员在设置页提交注销，服务端检查阻断项：待支付或退款中的订单、在场记录、钱包余额、未结束的预约。",
        "存在阻断项时返回 DELETION_BLOCKED 及逐项原因；没有则创建注销申请，effective_at 为 15 天后，并吊销全部会话。",
        "冷静期内重新登录可撤回申请。",
        "任务进程在 effective_at 后匿名化：清空昵称、头像、手机号字段，openid 改写为不可逆值，删除人脸数据，写审计。"
      ]
    }
  ],
  "inputs": [
    {
      "page": "登录页",
      "field": "agreed_versions",
      "label": "同意用户协议与隐私政策",
      "type": "勾选框",
      "required": true,
      "rule": "未勾选时登录按钮不可用；提交当前展示的协议版本。"
    },
    {
      "page": "登录页",
      "field": "code",
      "label": "登录凭证",
      "type": "自动获取",
      "required": true,
      "rule": "wx.login 返回值，5 分钟内有效，只能使用一次。"
    },
    {
      "page": "手机号授权弹窗",
      "field": "phone_code",
      "label": "手机号",
      "type": "微信授权按钮",
      "required": true,
      "rule": "用户拒绝授权时关闭弹窗，保留当前页面。"
    },
    {
      "page": "个人资料页",
      "field": "nickname",
      "label": "昵称",
      "type": "文本",
      "required": false,
      "rule": "1–20 个字符，提交后做内容安全检测。"
    },
    {
      "page": "个人资料页",
      "field": "avatar_file_id",
      "label": "头像",
      "type": "头像选择",
      "required": false,
      "rule": "通过头像填写能力选择，上传后得到文件编号。"
    },
    {
      "page": "个人资料页",
      "field": "gender",
      "label": "性别",
      "type": "单选",
      "required": false,
      "rule": "未知、男、女。"
    },
    {
      "page": "个人资料页",
      "field": "birthday",
      "label": "生日",
      "type": "日期",
      "required": false,
      "rule": "不晚于今天；用于生日权益，不对外展示。"
    },
    {
      "page": "注销页",
      "field": "reason",
      "label": "注销原因",
      "type": "单选 + 文本",
      "required": false,
      "rule": "文本不超过 200 字。"
    },
    {
      "page": "注销页",
      "field": "confirm",
      "label": "已阅读注销须知",
      "type": "勾选框",
      "required": true,
      "rule": "须知列出将删除的数据与保留的交易记录。"
    }
  ],
  "apis": [
    {
      "method": "POST",
      "path": "/api/v1/app/auth/wechat",
      "caller": "小程序",
      "purpose": "微信登录",
      "request": "code，agreed_versions[]（kind、version），store_code（可选）",
      "response": "access_token，refresh_token，expires_in，member{id，nickname，avatar_url，phone_bound}，need_consent[]",
      "errors": "WECHAT_CODE_INVALID，ACCOUNT_DISABLED，CONSENT_REQUIRED，UPSTREAM_BUSY"
    },
    {
      "method": "POST",
      "path": "/api/v1/app/auth/refresh",
      "caller": "小程序",
      "purpose": "轮换令牌",
      "request": "refresh_token",
      "response": "新的 access_token、refresh_token、expires_in",
      "errors": "REFRESH_INVALID，REFRESH_REUSED"
    },
    {
      "method": "POST",
      "path": "/api/v1/app/auth/logout",
      "caller": "小程序",
      "purpose": "退出登录",
      "request": "无（令牌在请求头）",
      "response": "空",
      "errors": "—"
    },
    {
      "method": "GET",
      "path": "/api/v1/app/me",
      "caller": "小程序",
      "purpose": "读取个人资料",
      "request": "无",
      "response": "id，nickname，avatar_url，gender，birthday，phone_masked，home_store",
      "errors": "UNAUTHORIZED"
    },
    {
      "method": "PATCH",
      "path": "/api/v1/app/me",
      "caller": "小程序",
      "purpose": "修改资料",
      "request": "nickname，avatar_file_id，gender，birthday（均可选）",
      "response": "更新后的资料",
      "errors": "CONTENT_RISKY，VALIDATION_FAILED"
    },
    {
      "method": "POST",
      "path": "/api/v1/app/me/phone",
      "caller": "小程序",
      "purpose": "绑定手机号",
      "request": "phone_code",
      "response": "phone_masked",
      "errors": "PHONE_IN_USE，WECHAT_CODE_INVALID"
    },
    {
      "method": "POST",
      "path": "/api/v1/app/me/deletion",
      "caller": "小程序",
      "purpose": "申请注销",
      "request": "reason",
      "response": "status，effective_at",
      "errors": "DELETION_BLOCKED（附 blockers[]）"
    },
    {
      "method": "DELETE",
      "path": "/api/v1/app/me/deletion",
      "caller": "小程序",
      "purpose": "撤回注销",
      "request": "无",
      "response": "status=cancelled",
      "errors": "DELETION_NOT_FOUND"
    },
    {
      "method": "GET",
      "path": "/api/v1/admin/members",
      "caller": "后台",
      "purpose": "查询会员",
      "request": "keyword（手机号后四位或昵称），status，store_id，cursor，limit",
      "response": "会员列表（手机号脱敏），next_cursor",
      "errors": "FORBIDDEN"
    },
    {
      "method": "POST",
      "path": "/api/v1/admin/members/{id}/disable",
      "caller": "后台",
      "purpose": "禁用会员",
      "request": "reason",
      "response": "status=disabled",
      "errors": "FORBIDDEN，NOT_FOUND"
    },
    {
      "method": "POST",
      "path": "/api/v1/admin/members/{id}/enable",
      "caller": "后台",
      "purpose": "解除禁用",
      "request": "reason",
      "response": "status=active",
      "errors": "FORBIDDEN，NOT_FOUND"
    }
  ],
  "results": [
    {
      "case": "登录成功且已绑定手机号",
      "page": "进入登录前的页面，没有则进入首页",
      "display": "首页显示会员昵称与可用卡概况。"
    },
    {
      "case": "登录成功但未绑定手机号",
      "page": "首页",
      "display": "在下单、储值、领取入场码之前弹出手机号授权；拒绝后停留原页面。"
    },
    {
      "case": "协议有新版本需要重新同意",
      "page": "协议更新弹窗",
      "display": "展示变更摘要与全文链接；同意后继续，拒绝则只能浏览公开内容。"
    },
    {
      "case": "账号被禁用",
      "page": "账号状态页",
      "display": "显示禁用原因与客服电话，不显示其他入口。"
    },
    {
      "case": "提交注销",
      "page": "注销进度页",
      "display": "显示冷静期截止日期与「撤回注销」按钮。"
    }
  ],
  "writes": [
    {
      "when": "首次登录",
      "table": "members",
      "content": "openid、unionid、home_store_id、status=active、last_login_at。"
    },
    {
      "when": "首次登录",
      "table": "user_consents",
      "content": "本次勾选的每份协议一条同意记录（场景 login）。"
    },
    {
      "when": "每次登录或刷新",
      "table": "member_sessions",
      "content": "刷新令牌摘要、family_id、客户端、IP、过期时间；旧记录写 replaced_by。"
    },
    {
      "when": "绑定手机号",
      "table": "members",
      "content": "phone_cipher、phone_hash、phone_masked。"
    },
    {
      "when": "绑定手机号、禁用、注销",
      "table": "audit_logs",
      "content": "操作者、对象、动作、变更前后（敏感字段脱敏）。"
    },
    {
      "when": "提交注销",
      "table": "member_deletion_requests",
      "content": "reason、status=pending、effective_at。"
    }
  ],
  "tables": [
    {
      "name": "members",
      "label": "会员",
      "purpose": "小程序用户主档",
      "fields": [
        {
          "name": "openid",
          "type": "VARCHAR(64)",
          "required": true,
          "default": "—",
          "comment": "小程序 openid，唯一"
        },
        {
          "name": "unionid",
          "type": "VARCHAR(64)",
          "required": false,
          "default": "—",
          "comment": "开放平台 unionid，有则保存"
        },
        {
          "name": "nickname",
          "type": "VARCHAR(40)",
          "required": false,
          "default": "—",
          "comment": "昵称"
        },
        {
          "name": "avatar_url",
          "type": "VARCHAR(512)",
          "required": false,
          "default": "—",
          "comment": "头像地址"
        },
        {
          "name": "gender",
          "type": "SMALLINT",
          "required": true,
          "default": "0",
          "comment": "0 未知，1 男，2 女"
        },
        {
          "name": "birthday",
          "type": "DATE",
          "required": false,
          "default": "—",
          "comment": "生日"
        },
        {
          "name": "phone_cipher",
          "type": "TEXT",
          "required": false,
          "default": "—",
          "comment": "手机号密文"
        },
        {
          "name": "phone_hash",
          "type": "CHAR(64)",
          "required": false,
          "default": "—",
          "comment": "手机号带密钥摘要，用于唯一与检索"
        },
        {
          "name": "phone_masked",
          "type": "VARCHAR(16)",
          "required": false,
          "default": "—",
          "comment": "脱敏手机号，用于展示"
        },
        {
          "name": "home_store_id",
          "type": "BIGINT",
          "required": false,
          "default": "—",
          "comment": "首次进入的门店"
        },
        {
          "name": "status",
          "type": "VARCHAR(16)",
          "required": true,
          "default": "active",
          "comment": "active、disabled、deleting、deleted"
        },
        {
          "name": "disabled_reason",
          "type": "VARCHAR(200)",
          "required": false,
          "default": "—",
          "comment": "禁用原因"
        },
        {
          "name": "last_login_at",
          "type": "TIMESTAMPTZ",
          "required": false,
          "default": "—",
          "comment": "最近登录时间"
        },
        {
          "name": "deleted_at",
          "type": "TIMESTAMPTZ",
          "required": false,
          "default": "—",
          "comment": "匿名化完成时间"
        }
      ],
      "indexes": [
        "UNIQUE(openid)",
        "UNIQUE(phone_hash) WHERE phone_hash IS NOT NULL",
        "INDEX(home_store_id, created_at)"
      ]
    },
    {
      "name": "member_sessions",
      "label": "会员会话",
      "purpose": "刷新令牌与登录链",
      "fields": [
        {
          "name": "member_id",
          "type": "BIGINT",
          "required": true,
          "default": "—",
          "comment": "会员"
        },
        {
          "name": "family_id",
          "type": "UUID",
          "required": true,
          "default": "—",
          "comment": "同一次登录产生的令牌链"
        },
        {
          "name": "refresh_hash",
          "type": "CHAR(64)",
          "required": true,
          "default": "—",
          "comment": "刷新令牌摘要，不保存明文"
        },
        {
          "name": "client",
          "type": "VARCHAR(32)",
          "required": true,
          "default": "miniprogram",
          "comment": "客户端类型"
        },
        {
          "name": "ip",
          "type": "VARCHAR(45)",
          "required": false,
          "default": "—",
          "comment": "登录 IP"
        },
        {
          "name": "user_agent",
          "type": "VARCHAR(256)",
          "required": false,
          "default": "—",
          "comment": "客户端标识"
        },
        {
          "name": "expires_at",
          "type": "TIMESTAMPTZ",
          "required": true,
          "default": "—",
          "comment": "过期时间"
        },
        {
          "name": "revoked_at",
          "type": "TIMESTAMPTZ",
          "required": false,
          "default": "—",
          "comment": "吊销时间"
        },
        {
          "name": "replaced_by",
          "type": "BIGINT",
          "required": false,
          "default": "—",
          "comment": "轮换后的新会话"
        }
      ],
      "indexes": [
        "UNIQUE(refresh_hash)",
        "INDEX(member_id, revoked_at)",
        "INDEX(family_id)"
      ]
    },
    {
      "name": "member_deletion_requests",
      "label": "注销申请",
      "purpose": "账号注销与冷静期",
      "fields": [
        {
          "name": "member_id",
          "type": "BIGINT",
          "required": true,
          "default": "—",
          "comment": "会员"
        },
        {
          "name": "reason",
          "type": "VARCHAR(200)",
          "required": false,
          "default": "—",
          "comment": "注销原因"
        },
        {
          "name": "status",
          "type": "VARCHAR(16)",
          "required": true,
          "default": "pending",
          "comment": "pending、cancelled、done"
        },
        {
          "name": "effective_at",
          "type": "TIMESTAMPTZ",
          "required": true,
          "default": "—",
          "comment": "冷静期截止时间"
        },
        {
          "name": "done_at",
          "type": "TIMESTAMPTZ",
          "required": false,
          "default": "—",
          "comment": "匿名化完成时间"
        }
      ],
      "indexes": [
        "UNIQUE(member_id) WHERE status = 'pending'"
      ]
    }
  ],
  "states": [
    {
      "entity": "会员",
      "from": "active",
      "event": "后台禁用",
      "to": "disabled",
      "condition": "写审计并吊销全部会话"
    },
    {
      "entity": "会员",
      "from": "disabled",
      "event": "后台解除禁用",
      "to": "active",
      "condition": "—"
    },
    {
      "entity": "会员",
      "from": "active",
      "event": "提交注销",
      "to": "deleting",
      "condition": "无阻断项"
    },
    {
      "entity": "会员",
      "from": "deleting",
      "event": "冷静期内撤回",
      "to": "active",
      "condition": "—"
    },
    {
      "entity": "会员",
      "from": "deleting",
      "event": "冷静期满",
      "to": "deleted",
      "condition": "任务进程执行匿名化"
    }
  ],
  "exceptions": [
    {
      "case": "code 已过期或重复使用",
      "handling": "返回 WECHAT_CODE_INVALID；前端重新调用 wx.login 再试一次，仍失败才提示。"
    },
    {
      "case": "微信接口超时",
      "handling": "退避重试一次；仍失败返回 UPSTREAM_BUSY，不创建会员。"
    },
    {
      "case": "同一 openid 并发首次登录",
      "handling": "openid 唯一约束兜底，冲突时读取已存在的会员继续签发令牌。"
    },
    {
      "case": "刷新令牌被重复使用",
      "handling": "吊销整条登录链，记录安全事件，要求重新登录。"
    },
    {
      "case": "会员被禁用时仍持有访问令牌",
      "handling": "鉴权中间件读取会员状态缓存，状态变更时删除缓存，禁用后下一次请求即返回 ACCOUNT_DISABLED。"
    },
    {
      "case": "注销时存在未完成事项",
      "handling": "返回 DELETION_BLOCKED 与逐项原因（待支付订单、退款中、在场、余额、预约），处理后再申请。"
    }
  ]
}
